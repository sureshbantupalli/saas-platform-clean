# Normalize line endings to LF in the repository.
# Git will convert to native endings on checkout (CRLF on Windows via core.autocrlf=true).
# Recommended local git config: git config core.autocrlf true

*         text=auto
*.py      text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf

# Binary files — never touch line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
