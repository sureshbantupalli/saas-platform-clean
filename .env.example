# ============================================================
# ANJASI platform — environment variables
# Copy to `.env` and fill in. NEVER commit the real .env.
#
#   cp .env.example .env
#
# Anything marked REQUIRED (prod) must be set on the production
# server or the app will run insecurely or fail to connect.
# ============================================================

# ── Django core ─────────────────────────────────────────────
# REQUIRED (prod). Long random string, unique per environment.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset, settings fall back to "dev-secret-key" — unsafe in production.
SECRET_KEY=

# Selects config/settings/production.py. Leave blank/unset locally.
# REQUIRED (prod): production
DJANGO_ENV=

# REQUIRED (prod). Comma-separated, no spaces, no scheme.
# e.g. app.setuyoga.com,www.app.setuyoga.com
ALLOWED_HOSTS=

# REQUIRED (prod). Comma-separated, WITH scheme.
# e.g. https://app.setuyoga.com
CSRF_TRUSTED_ORIGINS=

# ── Database (PostgreSQL) ───────────────────────────────────
# All REQUIRED (prod). Defaults in base.py are local-dev only.
DB_NAME=saas_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# Seconds to keep a DB connection open. 60 is sane behind gunicorn.
DB_CONN_MAX_AGE=60

# Set to `require` for a managed/remote Postgres (e.g. DigitalOcean).
# Leave blank for a local database.
DB_SSLMODE=

# ── Payments — Razorpay ─────────────────────────────────────
# REQUIRED (prod). Use test keys locally (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when the webhook endpoint is registered in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ── Platform tenant (ANJASI's own messaging) ────────────────
# ANJASI sends its own messages (studio onboarding, subscription invoices,
# service notices) through the normal communications engine under an internal
# tenant flagged is_platform=True. Provision it once per environment:
#     manage.py ensure_platform_tenant
# Defaults are fine; override only if the name/subdomain must differ.
PLATFORM_TENANT_NAME=ANJASI
PLATFORM_TENANT_SUBDOMAIN=anjasi

# ── Email (SMTP — AWS SES over its SMTP interface) ──────────
# The adapter is live: with EMAIL_HOST + DEFAULT_FROM_EMAIL set it sends a
# multipart HTML+text email through Django's mail framework; unset, it falls
# back to logging so dev/tests work unchanged. Because it goes through
# Django, any provider works (SES / SendGrid / Mailgun / a local relay) by
# changing these values alone.
#
# AWS SES notes:
#   * Create SMTP credentials in the SES console — these are NOT your normal
#     AWS access keys.
#   * Verify the sending domain (SPF + DKIM) or mail lands in spam.
#   * A new SES account is SANDBOXED: it can only send to verified addresses
#     until you request production access. Raise that request early.
#   * Host format: email-smtp.<region>.amazonaws.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Seconds before a stalled SMTP handshake is abandoned (default 10).
EMAIL_TIMEOUT=10

# REQUIRED once EMAIL_HOST is set — must be a verified SES identity.
# e.g. Setu Yoga <no-reply@setuyoga.com>
DEFAULT_FROM_EMAIL=

# Where Django mails unhandled-error reports. Defaults to DEFAULT_FROM_EMAIL.
SERVER_EMAIL=

# ── PER-TENANT MESSAGING CREDENTIALS ────────────────────────
# The MSG91 and WhatsApp values below are a DEVELOPMENT / SINGLE-TENANT
# fallback only. In production each tenant's credentials belong in
# TenantMessagingConfig (Django admin → Communications → Tenant messaging
# configs), because those accounts are registered to the tenant, not to
# ANJASI: the DLT sender header is tied to their Principal Entity and the
# WhatsApp Business Account to their phone number and verified name.
#
# With more than one tenant, any tenant lacking its own row falls back to
# these globals and sends under whichever credentials are here — which is a
# compliance problem, not just a bug. The app logs an ERROR when that happens.

# ── SMS (MSG91) ─────────────────────────────────────────────
# India requires DLT registration — allow several days lead time.
# The adapter is live: with AUTH_KEY + DLT_TE_ID set it sends via MSG91's
# Flow API; unset, it falls back to logging so dev/tests work unchanged.
# The DLT template registered with the operator must expose a `body`
# variable, which is where the rendered message is injected.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=
# Seconds before an MSG91 call is abandoned (default 10).
MSG91_TIMEOUT=10

# ── WhatsApp (Meta Cloud API, direct) ───────────────────────
# The adapter is live: with PHONE_NUMBER_ID + ACCESS_TOKEN set it sends via
# Meta's Cloud API; unset, it falls back to logging so dev/tests work
# unchanged. Requires Meta Business verification — allow lead time.
#
# THE 24-HOUR WINDOW (the WhatsApp equivalent of DLT):
# Meta only allows free-form text if the member messaged the business within
# the last 24 hours. Class reminders, receipts and renewal nudges are all
# business-initiated, so they fall OUTSIDE that window and are rejected with
# error 131047 unless sent as a pre-approved template.
#
# So for production: register a template whose body is a single {{1}}
# variable and set WHATSAPP_TEMPLATE_NAME to it. The rendered message is
# injected into that variable — the same one-variable shape MSG91 DLT uses.
# Leave the name blank only for testing or for replies inside the window.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Name of the approved template, and its language code (default en).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Graph API version (default v21.0) and request timeout in seconds.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT=10

# Shared secret echoed back during Meta's webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=

# ── Error monitoring (optional) ─────────────────────────────
SENTRY_DSN=

# ── Media storage (optional but recommended) ────────────────
# MEDIA_ROOT currently writes to local disk, so tenant logos and
# favicons are lost when the server is rebuilt. Point these at an
# S3/Spaces bucket once object storage is wired up.
MEDIA_STORAGE_BACKEND=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
